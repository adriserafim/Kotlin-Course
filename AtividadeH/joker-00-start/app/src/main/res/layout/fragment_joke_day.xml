<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_joke"
        android:layout_width="@dimen/img_joke_width"
        android:layout_height="@dimen/img_joke_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/img_joke_vertical_bias"
        tools:src="@drawable/logo" />

    <TextView
        android:id="@+id/txt_joke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/text_joke_margin_horizontal"
        android:layout_marginVertical="@dimen/text_joke_margin_vertical"
        app:layout_constraintTop_toBottomOf="@+id/img_joke"
        tools:text="Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida! Teste Pida!" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>