<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/home_img_user"
        android:layout_width="@dimen/home_img_user_width"
        android:layout_height="@dimen/home_img_user_height"
        android:layout_marginStart="@dimen/home_img_user_marginStart"
        android:layout_marginTop="@dimen/home_img_user_marginTop"
        android:src="@drawable/ic_insta_profile_thin"
        app:civ_border_color="@color/gray_border"
        app:civ_border_width="@dimen/home_img_user_border_width"
        app:civ_circle_background_color="@color/gray_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/home_txt_username"
        style="@style/Theme.Instagram.TextViewBase"
        android:layout_marginStart="@dimen/home_txt_username_marginStart"
        android:text="@string/username"
        app:layout_constraintBottom_toBottomOf="@id/home_img_user"
        app:layout_constraintStart_toEndOf="@id/home_img_user"
        app:layout_constraintTop_toTopOf="@id/home_img_user" />

    <ImageView
        android:id="@+id/home_ic_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/home_ic_more_marginEnd"
        android:contentDescription="@string/ic_more"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@id/home_img_user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/home_img_user" />

    <ImageView
        android:id="@+id/home_img_post"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/home_img_post_marginTop"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_img_user"
        tools:src="@tools:sample/backgrounds/scenic" />

    <LinearLayout
        android:id="@+id/home_container_user_comment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/home_container_user_marginHorizontal"
        android:padding="@dimen/home_container_user_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_img_post">

        <ImageView
            style="@style/Theme.Instagram.Icon"
            android:src="@drawable/ic_insta_heart" />

        <ImageView
            style="@style/Theme.Instagram.Icon"
            android:src="@drawable/ic_insta_comment" />

        <ImageView
            style="@style/Theme.Instagram.Icon"
            android:src="@drawable/ic_insta_send" />

    </LinearLayout>

    <TextView
        android:id="@+id/home_txt_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/home_txt_caption_marginHorizontal"
        android:ellipsize="marquee"
        android:maxLines="3"
        android:paddingHorizontal="@dimen/home_txt_caption_paddingHorizontal"
        android:text="@string/txt_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_container_user_comment"
        tools:text="Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption, Test Caption" />

</androidx.constraintlayout.widget.ConstraintLayout>