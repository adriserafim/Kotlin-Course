<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/search_paddingHorizontal"
    android:paddingVertical="@dimen/search_paddingVertical">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/search_img_user"
        android:layout_width="@dimen/search_img_user_width"
        android:layout_height="@dimen/search_img_user_height"
        android:src="@drawable/ic_insta_profile_thin"
        app:civ_border_color="@color/gray_border"
        app:civ_border_width="1dp"
        app:civ_circle_background_color="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/search_txt_username"
        style="@style/Theme.Instagram.TextViewBase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_txt_marginStart"
        android:text="@string/username"
        app:layout_constraintBottom_toTopOf="@id/search_txt_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/search_img_user"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/search_txt_name"
        style="@style/Theme.Instagram.TextViewBase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_txt_marginStart"
        android:text="@string/username"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/search_img_user"
        app:layout_constraintTop_toBottomOf="@id/search_txt_username" />

</androidx.constraintlayout.widget.ConstraintLayout>